VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: override the Edge TTS API endpoint (defaults to same-origin /api/tts).
# Useful for Capacitor/mobile builds to point at the deployed backend.
# VITE_TTS_API_URL=https://your-domain.vercel.app/api/tts

# Optional: ads. Leave unset to run completely ad-free — ads.js no-ops.
# VITE_ADS_ENABLED=true
# VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX (web PWA banner)
# VITE_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY (Capacitor/Android)
# VITE_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
# VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
# VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
